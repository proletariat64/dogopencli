{
  "domain": "liquidity",
  "name": "cash.balances",
  "adapter": "adapter.py:adapter",
  "summary": "Native account day-end balances for explicit dates.",
  "purpose": "Read unchanged day-end records from one source with independent acquisition coverage.",
  "operations": {
    "list": {
      "description": "List native account day-end balances for explicit inclusive dates.",
      "parameters": [
        {
          "name": "entity",
          "type": "string",
          "required": false,
          "description": "Optional native entity scope; default ALIPAYGM only when no explicit alias; ANY freezes local entities.",
          "multiple": true,
          "local_field": "entity"
        },
        {
          "name": "account-alias",
          "type": "string",
          "required": false,
          "description": "Optional exact native account aliases.",
          "multiple": true,
          "local_field": "aliasName"
        },
        {
          "name": "from-date",
          "type": "string",
          "required": true,
          "description": "Inclusive native valueDate; YYYY-MM-DD or YYYYMMDD; both dates required.",
          "local_field": "valueDate"
        },
        {
          "name": "to-date",
          "type": "string",
          "required": true,
          "description": "Inclusive native valueDate; YYYY-MM-DD or YYYYMMDD; both dates required.",
          "local_field": "valueDate"
        }
      ],
      "execution": "custom",
      "queries": {
        "balances": {
          "kind": "list",
          "collection": {
            "provider": "general",
            "paging": {
              "mode": "offset",
              "page_sizes": [
                500
              ]
            },
            "primary_id": {
              "type": "hash",
              "fields": [
                "entity",
                "bankId",
                "aliasName",
                "currency",
                "valueDate"
              ]
            },
            "latest_by": "__dogopencli_dayend_order"
          }
        },
        "roster": {
          "kind": "list",
          "collection": {
            "provider": "general",
            "paging": {
              "mode": "offset",
              "page_sizes": [
                1000
              ],
              "termination": "short_page"
            },
            "primary_id": {
              "type": "hash",
              "fields": [
                "aliasName",
                "currency"
              ]
            }
          }
        }
      },
      "max_requests": 10000,
      "budget_seconds": 900,
      "entity_selector": true,
      "account_directory": true,
      "history": {
        "interpretation": "calendar_date",
        "time_basis": "valueDate",
        "boundary": "inclusive",
        "timezone": null,
        "from_parameter": "from-date",
        "to_parameter": "to-date",
        "splitting": "explicit_windows",
        "cross_range_equivalence": false,
        "modification_time": "updateTime (native local format; timezone unknown)"
      }
    }
  },
  "identity": [
    "entity",
    "bankId",
    "aliasName",
    "currency",
    "valueDate"
  ],
  "identity_description": "Native entity, bank, alias, currency and valueDate composite business key.",
  "fields": [
    {
      "name": "entity",
      "type": "string",
      "meaning": "Native entity; preserved unchanged."
    },
    {
      "name": "bankId",
      "type": "string",
      "meaning": "Native bankId; preserved unchanged."
    },
    {
      "name": "aliasName",
      "type": "string",
      "meaning": "Native aliasName; preserved unchanged."
    },
    {
      "name": "accountNo",
      "type": "string",
      "meaning": "Native accountNo; preserved unchanged."
    },
    {
      "name": "currency",
      "type": "string",
      "meaning": "Native currency; preserved unchanged."
    },
    {
      "name": "valueDate",
      "type": "string",
      "meaning": "Native valueDate; preserved unchanged."
    },
    {
      "name": "openBalance",
      "type": "string",
      "meaning": "Native openBalance; preserved unchanged."
    },
    {
      "name": "openAvlBalance",
      "type": "string",
      "meaning": "Native openAvlBalance; preserved unchanged."
    },
    {
      "name": "closeBalance",
      "type": "string",
      "meaning": "Native closeBalance; preserved unchanged."
    },
    {
      "name": "closeAvlBalance",
      "type": "string",
      "meaning": "Native closeAvlBalance; preserved unchanged."
    },
    {
      "name": "timeZone",
      "type": "string",
      "meaning": "Native timeZone; preserved unchanged."
    },
    {
      "name": "statementCreateTime",
      "type": "string",
      "meaning": "Native statementCreateTime; preserved unchanged."
    },
    {
      "name": "updateTime",
      "type": "string",
      "meaning": "Native updateTime; preserved unchanged."
    },
    {
      "name": "source",
      "type": "string",
      "meaning": "Native source; preserved unchanged."
    }
  ],
  "dataset": {
    "relation": "liquidity_cash_balances"
  },
  "limitations": [
    "Only POST /dayendBalDetailQuery.json supplies balances; paired dates required for acquisition.",
    "Directory enumeration freezes current aliases, not historical ownership or proof all account balances are updated.",
    "No Get, history wrapper, generated business ID, timezone conversion, zero filling or source fallback."
  ],
  "examples": [
    {
      "title": "Explicit account day-end range",
      "command": "dogopencli liquidity list cash.balances --live --account-alias ACCOUNT --from-date 2026-09-18 --to-date 2026-09-18 --limit 0 --require-complete"
    }
  ]
}
