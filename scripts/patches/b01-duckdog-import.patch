+                with self.assertRaisesRegex(ImportRejected, "retired.*#164"):
+                    publish(self.root, selector, encode(candidate))
+                after = {
+                    p.relative_to(self.root): p.read_bytes()
+                    for p in self.root.rglob("*")
+                    if p.is_file()
+                }
+                self.assertEqual(before, after)
