+# Migration #257 only. Empty host scope means the package-owned native inquiry:
+# banks tenant; benchmarks fixed empty dates; forecast fixed instId=["Z21"].
+B01_LEAVES = frozenset(
+    {
+        "liquidity/reference/banks",
+        "liquidity/investment/benchmarks",
+        "liquidity/rules/forecast",
+    }
+)
+
+
+def acquisition_command(selector):
+    if selector in B01_LEAVES:
+        domain, *leaf = selector.split("/")
+        return [
+            "dogopencli",
+            domain,
+            "list",
+            ".".join(leaf),
+            "--live",
+            "--limit",
+            "0",
+            "--require-complete",
+            "--format",
+            "json",
+        ]
+    return [
+        "dogopencli",
+        *selector.split("/"),
+        "list",
+        "--live",
+        "--limit",
+        "0",
+        "--offset",
+        "0",
+        "--require-complete",
+        "--format",
+        "json",
+    ]
+
